# InvestEdge - configurazione dati reali (LOCALE, NON committare con chiavi vere)
#
# Come usarlo:
#   1. Copia questo file in backend/.env
#   2. Inserisci le tue API key (vedi link sotto)
#   3. Riavvia Avvia-InvestEdge.bat
#   4. Apri la pagina Dati e clicca "Aggiorna tutti i dati"
#
# Provider gratuiti predisposti:
#   Stooq (prezzi EOD, opt-in e mapping verificato; nessuna API key)
#   Finnhub (quote snapshot USA, key solo header e mapping verificato)
#   Alpha Vantage (solo news; prezzi disabilitati dalla policy secret-in-query)
#   CoinGecko (cripto, anche senza key): https://www.coingecko.com/en/api
#   FRED (tassi/bond, opzionale):        https://fred.stlouisfed.org/docs/api/api_key.html

# Attiva le chiamate reali (false = solo dati seed/demo)
ENABLE_REAL_DATA=false
# Stooq e' un opt-in separato e non deriva simboli dal ticker locale.
ENABLE_STOOQ=false
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=

# Cache e limiti giornalieri (proteggono dai rate limit dei tier gratuiti)
API_CACHE_TTL_HOURS=24
STOOQ_CACHE_TTL_HOURS=24
STOOQ_MINUTE_LIMIT=5
STOOQ_DAILY_LIMIT=100
STOOQ_MONTHLY_LIMIT=1000
FINNHUB_QUOTE_CACHE_TTL_SECONDS=60
FINNHUB_QUOTE_MINUTE_LIMIT=55
# Sicurezza trasporto provider: non inserire mai chiavi in URL o query string.
PROVIDER_HTTP_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_HTTP_READ_TIMEOUT_SECONDS=20
PROVIDER_RETRY_AFTER_CAP_SECONDS=60
PROVIDER_DEFAULT_MAX_ATTEMPTS=3
# Mapping ISIN OpenFIGI: key opzionale solo header, mai URL/query/log.
OPENFIGI_API_KEY=
OPENFIGI_CACHE_TTL_HOURS=168
OPENFIGI_MINUTE_LIMIT=5
OPENFIGI_DAILY_LIMIT=100
OPENFIGI_MONTHLY_LIMIT=1000
ALPHA_VANTAGE_DAILY_LIMIT=20
COINGECKO_DAILY_LIMIT=100
FRED_DAILY_LIMIT=100

# News reali (usano la chiave Alpha Vantage)
ENABLE_REAL_NEWS=false
NEWS_CACHE_TTL_HOURS=6
NEWS_DAILY_LIMIT=20
NEWS_SENTIMENT_WEIGHT=5

# Alert Telegram (vedi guida nel README)
ENABLE_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Import posizioni reali da Google Sheets (link CSV pubblicato)
ENABLE_GOOGLE_SHEETS_IMPORT=false
GOOGLE_SHEETS_CSV_URL=
