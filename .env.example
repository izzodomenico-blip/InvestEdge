INVESTEDGE_APP_NAME=InvestEdge API
INVESTEDGE_ENV=local
INVESTEDGE_API_VERSION=0.1.0
INVESTEDGE_DB_PATH=data/investedge.db
INVESTEDGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
INVESTEDGE_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):517\d+$

VITE_API_BASE_URL=http://127.0.0.1:8001

ENABLE_REAL_DATA=false
# Prezzi EOD Stooq: opt-in e solo con provider_symbols VERIFIED esplicito.
ENABLE_STOOQ=false
STOOQ_CACHE_TTL_HOURS=24
STOOQ_MINUTE_LIMIT=5
STOOQ_DAILY_LIMIT=100
STOOQ_MONTHLY_LIMIT=1000
# Quote snapshot Finnhub USA: token solo header e mapping QUOTE verificato.
FINNHUB_API_KEY=
FINNHUB_QUOTE_CACHE_TTL_SECONDS=60
FINNHUB_QUOTE_MINUTE_LIMIT=55
# Yahoo Finance resta disponibile solo per compatibilita', non come provider prezzo di rete.
YAHOO_DAILY_LIMIT=0
YAHOO_HISTORY_RANGE=5y
# Alpha Vantage e' disabilitato per i prezzi: le key in query non sono consentite.
ALPHA_VANTAGE_API_KEY=
# CoinGecko richiede un COINGECKO_ID verificato. La Demo key e' opzionale e usa
# soltanto l'header x-cg-demo-api-key; keyless non invia alcuna credenziale.
COINGECKO_API_KEY=
COINGECKO_EOD_CACHE_TTL_HOURS=24
COINGECKO_QUOTE_CACHE_TTL_SECONDS=60
COINGECKO_DEMO_MINUTE_LIMIT=90
COINGECKO_DEMO_MONTHLY_LIMIT=9000
COINGECKO_KEYLESS_MINUTE_LIMIT=10
COINGECKO_KEYLESS_MONTHLY_LIMIT=1000
FRED_API_KEY=
API_CACHE_TTL_HOURS=24
# Trasporto provider centralizzato: HTTPS/allowlist, timeout espliciti e retry limitati.
PROVIDER_HTTP_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_HTTP_READ_TIMEOUT_SECONDS=20
PROVIDER_RETRY_AFTER_CAP_SECONDS=60
PROVIDER_DEFAULT_MAX_ATTEMPTS=3
# OpenFIGI: key opzionale, inviata soltanto nell'header X-OPENFIGI-APIKEY.
OPENFIGI_API_KEY=
OPENFIGI_CACHE_TTL_HOURS=168
OPENFIGI_MINUTE_LIMIT=5
OPENFIGI_DAILY_LIMIT=100
OPENFIGI_MONTHLY_LIMIT=1000
ECB_FX_MAX_AGE_DAYS=7
ALPHA_VANTAGE_DAILY_LIMIT=20
FRED_DAILY_LIMIT=100

ENABLE_REAL_NEWS=false
# News reali: Yahoo Finance e' la fonte predefinita (nessuna API key, nessuna quota).
# Pertinenti sui singoli titoli; per ETF/crypto sono news generiche di mercato.
ENABLE_YAHOO_NEWS=true
YAHOO_NEWS_DAILY_LIMIT=0
# La stessa key Finnhub puo' essere usata dalle news quando abilitate.
NEWS_CACHE_TTL_HOURS=6
NEWS_DAILY_LIMIT=20
NEWS_SENTIMENT_WEIGHT=5

# Import posizioni da Google Sheets: disabilitato di default e limitato a 5 MiB.
ENABLE_GOOGLE_SHEETS_IMPORT=false
GOOGLE_SHEETS_CSV_URL=
GOOGLE_SHEETS_IMPORT_MAX_BYTES=5242880
