INVESTEDGE_APP_NAME=InvestEdge API
INVESTEDGE_ENV=local
INVESTEDGE_API_VERSION=0.1.0
INVESTEDGE_DB_PATH=data/investedge.db
INVESTEDGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
INVESTEDGE_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):517\d+$

VITE_API_BASE_URL=http://127.0.0.1:8001

ENABLE_REAL_DATA=false
# Prezzi EOD Stooq: opt-in e solo con provider_symbols VERIFIED esplicito.
ENABLE_STOOQ=false
STOOQ_CACHE_TTL_HOURS=24
STOOQ_MINUTE_LIMIT=5
STOOQ_DAILY_LIMIT=100
STOOQ_MONTHLY_LIMIT=1000
# Quote snapshot Finnhub USA: token solo header e mapping QUOTE verificato.
FINNHUB_API_KEY=
FINNHUB_QUOTE_CACHE_TTL_SECONDS=60
FINNHUB_QUOTE_MINUTE_LIMIT=55
# Yahoo Finance resta disponibile solo per compatibilita', non come provider prezzo di rete.
YAHOO_DAILY_LIMIT=0
YAHOO_HISTORY_RANGE=5y
# Alpha Vantage e' disabilitato per i prezzi: le key in query non sono consentite.
ALPHA_VANTAGE_API_KEY=
# CoinGecko richiede un COINGECKO_ID verificato. La Demo key e' opzionale e usa
# soltanto l'header x-cg-demo-api-key; keyless non invia alcuna credenziale.
COINGECKO_API_KEY=
COINGECKO_EOD_CACHE_TTL_HOURS=24
COINGECKO_QUOTE_CACHE_TTL_SECONDS=60
COINGECKO_DEMO_MINUTE_LIMIT=90
COINGECKO_DEMO_MONTHLY_LIMIT=9000
COINGECKO_KEYLESS_MINUTE_LIMIT=10
COINGECKO_KEYLESS_MONTHLY_LIMIT=1000
# FRED resta reference-only e disabilitato per policy: v1 richiede la key in query string,
# v2 offre solo download bulk. La key non viene mai usata per chiamate di rete.
FRED_API_KEY=
API_CACHE_TTL_HOURS=24
# Trasporto provider centralizzato: HTTPS/allowlist, timeout espliciti e retry limitati.
PROVIDER_HTTP_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_HTTP_READ_TIMEOUT_SECONDS=20
PROVIDER_RETRY_AFTER_CAP_SECONDS=60
PROVIDER_DEFAULT_MAX_ATTEMPTS=3
# OpenFIGI: key opzionale, inviata soltanto nell'header X-OPENFIGI-APIKEY.
OPENFIGI_API_KEY=
OPENFIGI_CACHE_TTL_HOURS=168
OPENFIGI_MINUTE_LIMIT=5
OPENFIGI_DAILY_LIMIT=100
OPENFIGI_MONTHLY_LIMIT=1000
# Cambi BCE verso EUR (reference rate giornaliero, keyless): refresh manuale POST /data/fx/refresh.
ECB_FX_MAX_AGE_DAYS=7
ECB_FX_CACHE_TTL_HOURS=6
ALPHA_VANTAGE_DAILY_LIMIT=20
FRED_DAILY_LIMIT=100

ENABLE_REAL_NEWS=false
# News reali: Finnhub e' l'unico provider live (key solo header X-Finnhub-Token,
# simbolo NEWS verificato e venue USA supportata). Yahoo e Alpha Vantage news sono
# disabilitati per policy (NOT_PRIMARY_POLICY / SECRET_IN_QUERY_POLICY).
FINNHUB_NEWS_MINUTE_LIMIT=55
# 0 = nessun limite mensile locale aggiuntivo.
FINNHUB_NEWS_MONTHLY_LIMIT=0
NEWS_CACHE_TTL_HOURS=6
NEWS_DAILY_LIMIT=20
NEWS_SENTIMENT_WEIGHT=5

# Import posizioni da Google Sheets: disabilitato di default e limitato a 5 MiB.
ENABLE_GOOGLE_SHEETS_IMPORT=false
GOOGLE_SHEETS_CSV_URL=
GOOGLE_SHEETS_IMPORT_MAX_BYTES=5242880

# Laboratorio di verita (SP1): nuovo segmento della serie oltre N sedute mancanti
# (giorni lavorativi per azioni/ETF, di calendario per le crypto) e tolleranza relativa
# della guardia split sui rapporti 2, 3, 4, 5, 10 e 3/2 (solo base di rettifica UNKNOWN).
LAB_SEGMENT_MAX_GAP_SESSIONS=5
LAB_SPLIT_TOLERANCE=0.03
# Esecutore dei job del laboratorio: thread (un worker in background, default) oppure inline (test).
LAB_JOBS_EXECUTOR=thread
# Simulatore del laboratorio (profilo costi Trade Republic, sovrascrivibile per run):
# commissione fissa per ordine eseguito (stop inclusi), costo per lato in bps (spread + slippage,
# cambio incluso) per azioni/ETF/ETC/ETN/obbligazioni e per le crypto, quote frazionarie per
# azioni ed ETF (le crypto sono sempre frazionarie), ordine minimo in EUR e sedute di attesa di un
# ordine senza barra del listing prima dell'annullamento.
TR_COMMISSION_EUR=1.00
TR_COST_BPS_EQUITY=10
TR_COST_BPS_CRYPTO=50
BACKTEST_FRACTIONAL_SHARES=false
BACKTEST_MIN_TRADE_EUR=100
LAB_ORDER_MAX_PENDING_SESSIONS=5
# Walk-forward del laboratorio: sedute della finestra in-sample (scelta dei parametri) e della finestra
# fuori campione (passo delle finestre mobili), sovrascrivibili per run.
LAB_WF_IS_SESSIONS=504
LAB_WF_OOS_SESSIONS=126

# Soglie evidenza REAL D/W/M (non validano intraday)
LAB_MIN_NAMES=10
LAB_MIN_IC_DATES=252
LAB_MIN_OOS_SESSIONS=252
LAB_MIN_T_STAT=2.0
LAB_MIN_DSR=0.95
LAB_REFERENCE_CAPITAL_EUR=10000
